# Stock Atlas Sprint 1 — Live SEC Validation Configuration
#
# Minimal configuration for SEC-only validation.
# No database or external providers required for this run.

# ============================================================================
# SEC EDGAR CONFIGURATION (REQUIRED)
# ============================================================================

# SEC requires a User-Agent header identifying your application.
# Set this to your name or contact email.
# SEC does not require an API key but appreciates identification.
#
# Example: "Project Stock Atlas user@example.com"
# Required: YES (SEC will reject requests without User-Agent)
SEC_USER_AGENT=Project Stock Atlas contact-email@example.com

# ============================================================================
# SEC RATE LIMITING
# ============================================================================

# SEC's published maximum is 10 requests per second.
# This is set conservatively to stay safe.
# Do not exceed 10 without explicit SEC permission.
# Keep as: <= 8
SEC_MAX_REQUESTS_PER_SECOND=8

# ============================================================================
# DATABASE (Optional for this validation)
# ============================================================================

# For live SEC validation, an in-memory database is fine.
# No external database required.
#
# If you want to persist results, use PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/atlas
#
# Default (in-memory, sufficient for validation):
DATABASE_URL=sqlite:///:memory:

# ============================================================================
# LOGGING
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================================================
# CACHE & ARCHIVE (Created automatically)
# ============================================================================

# These directories are created automatically by setup_live.sh
# No configuration needed here.
# CACHE_DIR will be: ./cache/
# FILING_ARCHIVE_DIR will be: ./sec_archive/
